# Скопируйте в .env и укажите LLM_API_KEY. Подойдёт любой OpenAI-совместимый провайдер.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Необязательные настройки, значения ниже совпадают с умолчаниями из src/core/env.schema.ts.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATA_DIR=data
LOG_DIR=logs
LOG_LEVEL=info
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=3
LLM_RETRY_MAX_WAIT_MS=60000
REDIS_URL=redis://127.0.0.1:6379
CHAT_MAX_JOBS_PER_MINUTE=4
CHAT_WAIT_TIMEOUT_MS=180000
