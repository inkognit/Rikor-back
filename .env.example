# Скопируйте в .env и укажите LLM_API_KEY. Подойдёт любой OpenAI-совместимый провайдер.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Необязательные настройки, значения ниже совпадают с умолчаниями из src/core/env.schema.ts.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATA_DIR=data
LOG_DIR=logs
LOG_LEVEL=info
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=1
